# ── Database (EasyPanel PostgreSQL) ──
# In production, EasyPanel injects DATABASE_URL with the internal host.
# For LOCAL dev, point this at your local Postgres or an EasyPanel external URL.
DATABASE_URL=postgres://wardabeaute:wardabeaute324@wardabeaute_database:5432/wardabeaute?sslmode=disable

# ── Admin ──
# Hash this with the helper script (npm run db:hash) or set a bcrypt hash directly.
ADMIN_PASSWORD=warda-admin-2026
JWT_SECRET=change-me-to-a-long-random-string

# ── WhatsApp (WATI) ──
WATI_API_TOKEN=
WATI_WABA_NUMBER=

# ── Public site URL (used for absolute links / pixels) ──
NEXT_PUBLIC_SITE_URL=https://wardabeaute.com

# ── Marketing pixels (optional) ──
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
