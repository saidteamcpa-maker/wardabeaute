# === Warda Beauté — Environment Variables ===

# Site URLs (used for OG tags, redirects, API calls)
NEXT_PUBLIC_SITE_URL=https://wardabeaute.com
NEXT_PUBLIC_API_URL=http://warda-backend:8000

# Tracking pixels (optional — leave empty to disable)
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=212779754660
NEXT_PUBLIC_PIXELS_ENABLED=true

# Database — PostgreSQL (EasyPanel provides this automatically)
DATABASE_URL="postgresql://user:password@warda-db:5432/warda"

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# SpaceSeller Marketplace (server-only — process.env.SPACESHELL_TOKEN in API routes, never NEXT_PUBLIC)
SPACESHELL_TOKEN=
SPACESSELLER_TOKEN=
SPACESHELL_BASE_URL=https://drop.spaceseller.ma/api/v1
SPACESSELLER_BASE_URL=https://drop.spaceseller.ma/api/v1
